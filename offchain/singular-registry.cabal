-- resulting state back — against a real devnet node, using the
-- same library code path as the end-to-end suite. Source lives in
-- journey/; every imported Haskell module stays untouched.
executable journey
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   journey
  main-is:          Main.hs
  other-modules:
    Journey.Chain
    Journey.Controls
    Journey.Identity
    Journey.Malformations
    Journey.Narration
    Journey.Options
    Journey.Proofs
    Journey.Scenario
    Journey.Steps

  build-depends:
    , aeson
    , base                         >=4.14 && <5
