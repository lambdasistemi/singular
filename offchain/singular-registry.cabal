-- #173 A173-COMMAND: the packaged `insert-active` verb the release
-- archive documents. A reviewer with the extracted archive and no
-- checkout runs it against a devnet: the open registry boots, one
-- certified insertActive folds, and the active token lands at the
-- wallet the request named. Ships on the pre-#183 request wire.
executable insert-active
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   insert-active
  main-is:          Main.hs
  other-modules:
    InsertActive.Controls
    InsertActive.Narration
    InsertActive.Observation
    InsertActive.Options
    InsertActive.Scenario
    InsertActive.Steps

  build-depends:
    , aeson
    , aeson-pretty
    , base                         >=4.14 && <5
    , base16-bytestring
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients:devnet
    , cardano-tx-tools:tx-build
    , containers
    , microlens
    , singular-registry
    , text

  ghc-options:      -threaded -with-rtsopts=-N

-- #177 I177-COMMAND: the packaged `update-terminal` verb the release
-- archive documents, a sibling of `insert-active` rather than a mode
-- bolted onto an unrelated tool. A reviewer with the extracted archive
-- and no checkout runs it against a devnet: the open registry boots,
-- one key is booked ACTIVE at a wallet, and that same key is retired —
-- its witness burned out of the wallet that held it and its leaf
-- committed Terminal. Ships on the pre-#183 request wire.
executable update-terminal
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   update-terminal
