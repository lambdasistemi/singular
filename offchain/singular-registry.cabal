  -- #267: the fold's focused owners behind the Update facade. They are
  -- implementation modules of the existing public library: the facade
  -- re-exports their names as the unchanged public API, and the
  -- generated API reference discovers them here.
  --
  -- #268: the registry wire's focused owners behind the Types facade.
  -- Same arrangement: Singular.Registry.Types re-exports the unchanged
  -- public wire surface from these five, each definition beside its
  -- encoding instances, and the generated API reference documents them
  -- here for the contributor while callers keep importing the facade.
  other-modules:
    Singular.Registry.Deployment.Attach
    Singular.Registry.Deployment.Manifest
    Singular.Registry.Deployment.Mirror
    Singular.Registry.TrieState.Core
    Singular.Registry.TrieState.Types
    Singular.Registry.TxBuilder.Update.Build
    Singular.Registry.TxBuilder.Update.Context
    Singular.Registry.TxBuilder.Update.Duties
    Singular.Registry.Wire.Primitive
    Singular.Registry.Wire.Proof
    Singular.Registry.Wire.Redeemer
    Singular.Registry.Wire.Request
    Singular.Registry.Wire.State

  -- #269: the deployment record's focused owners behind the
  -- Deployment facade. Same arrangement as the fold and wire owners
  -- above: Singular.Registry.Deployment re-exports the unchanged
  -- public surface from these three, each declaration beside its own
  -- concern, and the generated API reference documents them here.
  reexported-modules:
    , Singular.Registry.Ledger
    , Singular.Registry.LedgerProvider
    , Singular.Registry.Evidence
    , Singular.Registry.Signing

