cabal-version: 3.4
name:          singular-registry
version:       0.16.0.0
synopsis:      Registry validator types, tx builders, and E2E tests
description:
  PlutusData types matching the Aiken cage validator,
  transaction builders using the TxBuild DSL from
  cardano-node-clients, JSON/Aiken test vector generator,
  and devnet E2E tests. Single source of truth for all
  Haskell cage code.

license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple
data-files:
  data/contracts/*.json
  data/network/devnet/*.cbor
  data/network/devnet/*.json
  data/network/preprod/*.cbor
  data/network/preprod/*.json
  data/network/preprod/evaluation/*.cbor
  data/network/preprod/evaluation/*.json

-- Explicit test composition only; automatic solver selection is forbidden.
flag test-harness
  description: Compile recovery fault injection and independent trie diagnostics
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:             warnings
  default-language:   GHC2021
  hs-source-dirs:     lib naming/src
  build-depends:
    , aeson                             >=2.1  && <2.3
    , aeson-pretty
    , base                              >=4.14 && <5
    , base16-bytestring
    , bech32
    , bytestring                        >=0.11 && <0.13
    , cardano-crypto-class
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , cardano-strict-containers
    , cardano-tx-tools:tx-build
    , containers                        >=0.6  && <0.8
    , contra-tracer
    , crypton
    , directory
    , filepath
    , memory
    , microlens
    , mtl
    , mts:mpf-write
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , process
    , scientific
    , serialise
    , singular-registry:local-services
    , text                              >=2.0  && <2.2
    , time
    , unix

  exposed-modules:
    Naming.Datum
    Naming.Register
    Naming.Request
    Naming.Verify
    Naming.Wire
    Naming.Wire.Vectors
    Singular.Provider.Koios.Client
    Singular.Provider.Koios.Evidence
    Singular.Provider.Koios.History
    Singular.Provider.Koios.Provider
    Singular.Provider.Koios.Recorded
    Singular.Provider.Koios.Runtime
    Singular.Provider.Koios.State
    Singular.Provider.Koios.Wire
