-- The bounded journey runner (D-012): narrates the registry
-- journey — boot a cage, submit a request, apply it, read the
-- resulting state back — against a real devnet node, using the
-- same library code path as the E2E suite. Source lives in
-- journey/; every imported Haskell module stays untouched.
executable journey
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   journey
  main-is:          Main.hs
  other-modules:
    Journey.Chain
    Journey.Controls
    Journey.Identity
    Journey.Malformations
    Journey.Narration
    Journey.Options
    Journey.Proofs
    Journey.Scenario
    Journey.Steps

  build-depends:
    , aeson
    , base               >=4.14 && <5
    , base16-bytestring
    , bytestring
    , cardano-ledger-api
    , cardano-ledger-core
    , cardano-ledger-mary
    , singular-registry
    , cardano-node-clients
    , cardano-node-clients:devnet
    , cardano-tx-tools:tx-build
    , containers
    , microlens
    , mts:mpf-write
    , plutus-tx
    , text

  ghc-options:      -threaded -with-rtsopts=-N

-- The LI01 canonical-initialization runner (issue #47): executes
-- the contract row LI01-canonical-initialization-accepts on a real
-- devnet, reads the resulting state, binding, checkpoint datum and
-- witness shape back from the chain, and fails non-zero on any
-- mismatch. Source lives in journey/li01/; the naming codec comes
-- from the library (Naming.* moved inside this flake root, issue
-- #51) and every imported Haskell module stays untouched.
