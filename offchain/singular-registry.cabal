    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers
    , crypton
    , filepath
    , memory
    , microlens
    , ouroboros-consensus
    , serialise
    , text
    , time
    , transformers
    , unix

