cabal-version: 3.4
name:          singular-registry
version:       0.1.0.0
synopsis:      Registry validator types, tx builders, and E2E tests
description:
  PlutusData types matching the Aiken cage validator,
  transaction builders using the TxBuild DSL from
  cardano-node-clients, JSON/Aiken test vector generator,
  and devnet E2E tests. Single source of truth for all
  Haskell cage code.

license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   lib naming/src
  build-depends:
    , aeson                  >=2.1  && <2.3
    , aeson-pretty
    , base                   >=4.14 && <5
    , base16-bytestring
    , bytestring             >=0.11 && <0.13
    , cardano-crypto-class
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-binary
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-strict-containers
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , cardano-node-clients:devnet
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers             >=0.6  && <0.8
    , crypton
    , directory
    , filepath
    , memory
    , microlens
    , mts:mpf-write
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , process
    , singular-registry:node-internal
    , text                   >=2.0  && <2.2
    , time

  exposed-modules:
    Singular.Application.OpenDatum.Book
    Singular.Application.OpenDatum.Envelope
    Singular.Application.OpenDatum.Release
    Singular.Application.OpenDatum.Script
    Singular.Application.OpenDatum.Update
    Singular.Registry.AssetName
    Singular.Registry.Blueprint
    Singular.Registry.Blueprint.Load
    Singular.Registry.Blueprint.Params
    Singular.Registry.Blueprint.Schema
    Singular.Registry.Candidate
    Singular.Registry.Config
    Singular.Registry.Config.Application
    Singular.Registry.Deployment
    Singular.Registry.Driver
    Singular.Registry.Lifecycle
    Singular.Registry.Node
    Singular.Registry.Proof
    Singular.Registry.Trie
    Singular.Registry.Trie.Pure
    Singular.Registry.Trie.PureManager
    Singular.Registry.TxBuilder.Boot
    Singular.Registry.TxBuilder.Edges
    Singular.Registry.TxBuilder.Internal
    Singular.Registry.TxBuilder.Internal.Edges
    Singular.Registry.TxBuilder.Internal.Identity
    Singular.Registry.TxBuilder.Internal.Lookup
    Singular.Registry.TxBuilder.Register
    Singular.Registry.TxBuilder.Reject
    Singular.Registry.TxBuilder.Request
    Singular.Registry.TxBuilder.Retract
    Singular.Registry.TxBuilder.ConnectedFold
    Singular.Registry.TxBuilder.Update
    Singular.Registry.Types
    Naming.Datum
    Naming.Register
    Naming.Request
    Naming.Verify
    Naming.Wire
    Naming.Wire.Vectors

  -- #267: the fold's focused owners behind the Update facade. They are
  -- implementation modules of the existing public library: the facade
  -- re-exports their names as the unchanged public API, and the
  -- generated API reference discovers them here.
  --
  -- #268: the registry wire's focused owners behind the Types facade.
  -- Same arrangement: Singular.Registry.Types re-exports the unchanged
  -- public wire surface from these five, each definition beside its
  -- encoding instances, and the generated API reference documents them
  -- here for the contributor while callers keep importing the facade.
  other-modules:
    -- #269: the deployment record's focused owners behind the
    -- Deployment facade. Same arrangement as the fold and wire owners
    -- above: Singular.Registry.Deployment re-exports the unchanged
    -- public surface from these three, each declaration beside its own
    -- concern, and the generated API reference documents them here.
    Singular.Registry.Deployment.Manifest
    Singular.Registry.Deployment.Mirror
    Singular.Registry.Deployment.Attach
    Singular.Registry.TxBuilder.Update.Build
    Singular.Registry.TxBuilder.Update.Context
    Singular.Registry.TxBuilder.Update.Duties
    Singular.Registry.Wire.Primitive
    Singular.Registry.Wire.Request
    Singular.Registry.Wire.State
    Singular.Registry.Wire.Proof
    Singular.Registry.Wire.Redeemer

  reexported-modules:
    , Singular.Registry.Ledger
    , Singular.Registry.Provider

-- The private Node ownership core (issue #266, A-003): the six focused
-- Node children plus the two modules they read (Ledger, Provider) live in
-- one package-private internal library so the public facade and the cage
-- test component link the SAME compiled instance of every process global.
-- The public library re-exports Ledger and Provider under their original
-- import paths; the Node children stay reachable only through the facade's
-- export list.
library node-internal
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   node-internal
  exposed-modules:
    Singular.Registry.Ledger
    Singular.Registry.Provider
    Singular.Registry.Node.Options
    Singular.Registry.Node.Wallet
    Singular.Registry.Node.Wait
    Singular.Registry.Node.Indexer
    Singular.Registry.Node.Session
    Singular.Registry.Node.Confirmation
    Singular.Registry.Node.Funding
  build-depends:
    , aeson
    , async
    , base                   >=4.14 && <5
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-strict-containers
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , cardano-node-clients:devnet
    , cardano-node-clients:utxo-indexer-lib
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers             >=0.6  && <0.8
    , contra-tracer
    , directory
    , filepath
    , microlens
    , ouroboros-consensus
    , ouroboros-network:api
    , process
    , text
    , time

