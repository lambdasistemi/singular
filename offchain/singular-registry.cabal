-- #299: the packaged `singular registry create|insert|terminate|inspect`
-- commands. One ordinary process per command over a saved registry
-- directory: the node and wallet are the caller's, the registry is the
-- one the directory records, and nothing is booted a second time.
-- #528 slice 3: the packaged singular command. Main composes the
-- application value and runs the registry verbs from the registry-cli
-- library; no command-line source is compiled here.
executable singular
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   cli
  main-is:          Main.hs

  build-depends:
    , base                              >=4.14 && <5
    , singular-registry
    , singular-registry:registry-cli

  ghc-options:      -threaded -with-rtsopts=-N

-- A test-harness tool for the packaged controls, never evidence: seals a
-- devnet key file into a wallet vault with the production sealing.
executable vault-seal
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   test/vault-seal
  main-is:          Main.hs

  build-depends:
    , base                              >=4.14 && <5
    , bytestring
    , singular-registry:local-services
    , singular-registry:registry-cli

  ghc-options:      -threaded -with-rtsopts=-N
