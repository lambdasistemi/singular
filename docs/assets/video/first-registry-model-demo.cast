{"version": 2, "width": 80, "height": 24, "timestamp": 1790175445, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "Singular D-01 registry model rehearsal"}
[0.060684, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.061516, "o", "\u001b[1;36mD-01 | Singular registry model rehearsal\u001b[0m\r\n\r\n\u001b[0;90m# Fictional asset ORCHID-42 is model key 42, not a Cardano token.\u001b[0m\r\n\u001b[0;90m# Model play only; no release archive or ledger transaction.\u001b[0m\r\n\r\n\u001b[1;32m$ node demo/first-registry-demo.mjs\u001b[0m\r\n\r\n\u001b[1;33mStarting leaf=unknown; custody=0; held tokens=0\u001b[0m\r\n\u001b[1;33mModel SHA256 prefix: d0eae5fc7a32b644\u001b[0m\r\n"]
[3.564999, "o", "\u001b[H\u001b[2J\u001b[3J"]
[3.565043, "o", "\u001b[1;36m1 | Record the absence\u001b[0m\r\n"]
[3.565163, "o", "\r\n\u001b[0;90m# The funder records that this key is not yet booked.\u001b[0m\r\n\u001b[0;90m# The absent token and deposit enter registry custody.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(insertAbsent, key=42, funder=91, deposit=200)\u001b[0m\r\n"]
[3.565199, "o", "\r\n"]
[3.566813, "o", "\u001b[1;33mACCEPTED  leaf=absent  mint=absent+1\u001b[0m\r\n"]
[3.566826, "o", "\u001b[1;33mpaid=none\u001b[0m\r\n"]
[3.566847, "o", "\u001b[1;33mcustody=1  active=0\u001b[0m\r\n\u001b[1;33mterminal witnesses=0\u001b[0m\r\n"]
[7.070985, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m2 | Wrong approval tuple is refused\u001b[0m\r\n"]
[7.071137, "o", "\r\n\u001b[0;90m# An approval under the right policy still has to name this request.\u001b[0m\r\n\u001b[0;90m# The custody entry survives this attempted booking.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(updateActive, wrong approval key)\u001b[0m\r\n\r\n"]
[7.071602, "o", "\u001b[0;31mEXPECTED REFUSAL: approval-mismatch\u001b[0m\r\n"]
[7.071666, "o", "\u001b[1;33mstate unchanged; leaf=absent\u001b[0m\r\n"]
[10.572977, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m3 | Book the key and return the deposit\u001b[0m\r\n"]
[10.573111, "o", "\r\n\u001b[0;90m# A matching approval books the absent key as active.\u001b[0m\r\n\u001b[0;90m# The recorded funder gets the 200 model units back.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(updateActive, key=42, output=555)\u001b[0m\r\n\r\n"]
[10.573737, "o", "\u001b[1;33mACCEPTED  leaf=active  mint=absent-1, active+1\u001b[0m\r\n"]
[10.573782, "o", "\u001b[1;33mpaid=200 -> address 91\u001b[0m\r\n\u001b[1;33mcustody=0  active=1\u001b[0m\r\n\u001b[1;33mterminal witnesses=0\u001b[0m\r\n"]
[10.573858, "o", "\u001b[1;33mactive token output=555\u001b[0m\r\n"]
[14.077035, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m4 | Retire the booked key\u001b[0m\r\n"]
[14.077188, "o", "\r\n\u001b[0;90m# Retirement consumes the active token.\u001b[0m\r\n\u001b[0;90m# The registry leaf becomes terminal.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(updateTerminal, key=42)\u001b[0m\r\n\r\n"]
[14.077615, "o", "\u001b[1;33mACCEPTED  leaf=terminal  mint=active-1\u001b[0m\r\n\u001b[1;33mpaid=none\u001b[0m\r\n"]
[14.077664, "o", "\u001b[1;33mcustody=0  active=0\u001b[0m\r\n\u001b[1;33mterminal witnesses=0\u001b[0m\r\n"]
[17.57824, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m5 | First terminal witness\u001b[0m\r\n"]
[17.578406, "o", "\r\n\u001b[0;90m# A terminal witness attests a leaf that has already ended.\u001b[0m\r\n\u001b[0;90m# The leaf and registry root do not change.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(witnessTerminal, key=42, output=700)\u001b[0m\r\n\r\n"]
[17.578706, "o", "\u001b[1;33mACCEPTED  leaf=terminal  mint=terminal+1\u001b[0m\r\n\u001b[1;33mpaid=none\u001b[0m\r\n\u001b[1;33mcustody=0  active=0\u001b[0m\r\n"]
[17.578754, "o", "\u001b[1;33mterminal witnesses=1\u001b[0m\r\n"]
[21.081052, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m6 | Second terminal witness\u001b[0m\r\n"]
[21.08124, "o", "\r\n\u001b[0;90m# The model permits a second witness for the same terminal leaf.\u001b[0m\r\n\u001b[0;90m# Both witness holdings are visible; no new incarnation appears.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(witnessTerminal, key=42, output=701)\u001b[0m\r\n\r\n"]
[21.081844, "o", "\u001b[1;33mACCEPTED  leaf=terminal  mint=terminal+1\u001b[0m\r\n\u001b[1;33mpaid=none\u001b[0m\r\n"]
[21.081893, "o", "\u001b[1;33mcustody=0  active=0\u001b[0m\r\n\u001b[1;33mterminal witnesses=2\u001b[0m\r\n"]
[24.582898, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m7 | Terminal key cannot be booked again\u001b[0m\r\n"]
[24.582937, "o", "\r\n\u001b[0;90m# A valid approval cannot override the terminal leaf.\u001b[0m\r\n"]
[24.583062, "o", "\u001b[0;90m# The two witnesses stay in place after refusal.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(updateActive, key=42 after retirement)\u001b[0m\r\n\r\n"]
[24.58342, "o", "\u001b[0;31mEXPECTED REFUSAL: terminal-immutable\u001b[0m\r\n"]
[24.583495, "o", "\u001b[1;33mstate unchanged; leaf=terminal\u001b[0m\r\n"]
[28.086942, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m8 | Missing token delta is refused\u001b[0m\r\n"]
[28.087097, "o", "\r\n\u001b[0;90m# A folded witness must claim the model-required mint delta.\u001b[0m\r\n\u001b[0;90m# Omitting that delta refuses the batch and keeps state unchanged.\u001b[0m\r\n\r\n\u001b[1;32m$ foldBatch(witnessTerminal, claimed mint=[])\u001b[0m\r\n\r\n"]
[28.087471, "o", "\u001b[0;31mEXPECTED REFUSAL: net-mint-mismatch\u001b[0m\r\n"]
[28.087544, "o", "\u001b[1;33mstate unchanged; leaf=terminal\u001b[0m\r\n"]
[31.591049, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mModel play complete | acceptance still open\u001b[0m\r\n"]
[31.591127, "o", "\r\n\u001b[0;90m# Shown: custody refund, retirement, plural witnesses, refusals.\u001b[0m\r\n\u001b[0;90m# Not shown: released archive, scripts, tx IDs, node readbacks.\u001b[0m\r\n\u001b[0;90m# Those are the separate 8 October devnet acceptance gate.\u001b[0m\r\n"]
[31.591329, "o", "\u001b[1;33mFinal leaf=terminal; witnesses=2\u001b[0m\r\n\u001b[1;33mModel source SHA256:\u001b[0m\r\n\u001b[1;33md0eae5fc7a32b644a4fdcc583fc016125b7093b359583432c01a18ea8951a3e1\u001b[0m\r\n"]
