[2.112908, "o", "\u001b[H\u001b[2J\u001b[3J"]
[2.113679, "o", "\u001b[1;36mD-02 | naming lifecycle model rehearsal\u001b[0m\r\n\r\n\u001b[0;90m# Fictional alice is model key 42; addresses are fixture bytes.\u001b[0m\r\n\u001b[0;90m# No real Cardano asset, destination, signature or transaction.\u001b[0m\r\n\r\n\u001b[1;32m$ lake env lean --run lean/LifecycleMain.lean\u001b[0m\r\n\r\n\u001b[1;33mLean source SHA256: ac2c5ef33d34084c32c37b701e8ec9c4ab5b088cab75190e675b1f1686fb5f56\u001b[0m\r\n"]
[5.616682, "o", "\u001b[H\u001b[2J\u001b[3J"]
[5.616784, "o", "\u001b[1;36m1 | Maintain the payment destination\u001b[0m\r\n"]
[5.617073, "o", "\r\n\u001b[0;90m# The current controller changes the fixture destination.\u001b[0m\r\n\u001b[0;90m# The registry root must stay equal.\u001b[0m\r\n\r\n"]
[5.61715, "o", "\u001b[1;32m$ Lean maintenance rows LM01 and LM04\u001b[0m\r\n"]
[5.61722, "o", "\r\n"]
[5.617394, "o", "\u001b[1;33mLEAN ROW HELD: LM01-maintenance-accepts\u001b[0m\r\n"]
[5.617455, "o", "\u001b[1;33mLEAN ROW HELD: LM04-root-equal-after-maintenance\u001b[0m\r\n"]
[9.120991, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m2 | Refuse unauthorized maintenance\u001b[0m\r\n"]
[9.121244, "o", "\r\n\u001b[0;90m# A missing controller signature cannot change the record.\u001b[0m\r\n\r\n\u001b[1;32m$ Lean maintenance row LM02\u001b[0m\r\n"]
[9.12126, "o", "\r\n"]
[9.121367, "o", "\u001b[0;31mEXPECTED REFUSAL: LM02-maintenance-unauthorized-refused\u001b[0m\r\n\u001b[0;31mreason=controller-signature\u001b[0m\r\n"]
[12.625042, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m3 | Recover committed control\u001b[0m\r\n"]
[12.62531, "o", "\r\n\u001b[0;90m# The revealed precommitted control signs; the root stays equal.\u001b[0m\r\n\r\n\u001b[1;32m$ Lean recovery rows LR01 and LR11\u001b[0m\r\n\r\n"]
[12.62535, "o", "\u001b[1;33mLEAN ROW HELD: LR01-recovery-accepts\u001b[0m\r\n\u001b[1;33mLEAN ROW HELD: LR11-root-equal-after-recovery\u001b[0m\r\n"]
[16.128976, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36m4 | Refuse wrong or missing recovery evidence\u001b[0m\r\n"]
[16.129204, "o", "\r\n\u001b[0;90m# The wrong revealed key and a missing signer each fail.\u001b[0m\r\n\r\n"]
[16.129241, "o", "\u001b[1;32m$ Lean recovery rows LR02 and LR03\u001b[0m\r\n\r\n\u001b[0;31mEXPECTED REFUSAL: LR02-wrong-reveal-refused\u001b[0m\r\n\u001b[0;31mreason=recovery-commitment\u001b[0m\r\n\u001b[0;31mEXPECTED REFUSAL: LR03-missing-recovery-signer-refused\u001b[0m\r\n\u001b[0;31mreason=recovery-required-signer\u001b[0m\r\n"]
[19.633231, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1;36mModel rehearsal complete | devnet target open\u001b[0m\r\n"]
