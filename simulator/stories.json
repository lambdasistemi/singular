 {
  "id": "witness",
  "title": "Witness an absence, then book it",
  "blurb": "Anyone may record that a key is unknown. The absent token lives in the cage, and booking consumes it and pays the deposit back to whoever funded it.",
  "steps": [
   {
    "what": "insertAbsent records the absence; the token goes to cage custody",
    "request": {
     "edge": "insertAbsent",
     "key": 42,
     "owner": 91,
     "refundAddress": 91,
     "deposit": 200,
     "output": 0,
     "approval": {
      "policy": 7,
      "edge": "insertAbsent",
      "key": 42,
      "owner": 91,
      "destination": 0,
      "assetName": 3021472884,
      "signatures": []
     },
     "claimed": []
    },
    "expect": "accept"
   },
   {
    "what": "updateActive books it, consuming the absent token",
    "request": {
     "edge": "updateActive",
     "key": 42,
     "owner": 42,
     "refundAddress": 0,
     "deposit": 0,
     "output": 555,
     "approval": {
      "policy": 7,
      "edge": "updateActive",
      "key": 42,
      "owner": 42,
      "destination": 555,
      "assetName": 84686170,
      "signatures": []
     },
     "claimed": []
    },
    "expect": "accept"
   }
  ],
  "forks": [
   {
    "at": 1,
    "steps": [
     {
      "what": "the inserter retracts instead, and the deposit returns",
      "request": {
       "edge": "deleteAbsent",
       "key": 42,
       "owner": 91,
       "refundAddress": 0,
       "deposit": 0,
       "output": 0,
       "approval": {
        "policy": 7,
        "edge": "deleteAbsent",
        "key": 42,
        "owner": 91,
        "destination": 0,
        "assetName": 2709712832,
        "signatures": []
       },
       "claimed": []
      },
      "expect": "accept"
     }
    ]
   }
  ]
 },
 {
