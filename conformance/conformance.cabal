    Conformance.Run.Receipts
    Conformance.Run.Replay
    Conformance.Run.Retraction
    Conformance.Run.Step
    Conformance.Run.Submit
    Conformance.Run.Units
    Conformance.Run.Wallet
    Conformance.ScriptParameters
    Paths_conformance
    Singular.Registry.Private.Archive
    Singular.Registry.Private.EpochParameters
    Singular.Registry.Private.Facade
    Singular.Registry.Private.Source
    Singular.Registry.Private.TimePublication

  build-depends:
    , aeson                             >=2.1     && <2.3
    , async
    , base                              >=4.14    && <5
    , base16-bytestring
    , bytestring                        >=0.11    && <0.13
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-ledger-read
    , cardano-node-clients
    , cardano-node-clients:devnet
    , cardano-slotting
    , cardano-strict-containers
    , cardano-tx-tools:tx-build
    , case-insensitive
    , chain-follower
    , conformance
    , containers                        >=0.6     && <0.8
    , contra-tracer
    , crypton
    , directory                         >=1.3     && <1.4
    , filepath                          >=1.4     && <1.6
    , http-types
    , memory
    , microlens
    , mts:mpf-write
    , operational                       >=0.2.4.2 && <0.3
    , ouroboros-consensus
    , ouroboros-consensus:cardano
    , ouroboros-consensus:protocol
    , ouroboros-network:api
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , process                           >=1.6     && <1.7
    , serialise
    , singular-registry
    , singular-registry:koios-http
    , singular-registry:local-services
    , text                              >=2.0     && <2.2
    , time
    , transformers
    , unix
    , vector                            >=0.13    && <0.14
    , wai
    , warp

  ghc-options:    -threaded -with-rtsopts=-N

executable conformance
  import:         warnings, live-runner
  hs-source-dirs: app-default
  main-is:        Main.hs

-- #299: the ordinary CLI's refusal controls, run against a node and
-- judged from their receipts.
executable cli-controls
  import:         warnings
  hs-source-dirs: app-cli
  main-is:        Main.hs
  other-modules:
    Conformance.Cli.Admission
    Conformance.Cli.Attach
    Conformance.Cli.Backend
    Conformance.Cli.FoldHistory
    Conformance.Cli.Node
    Conformance.Cli.Proof
    Conformance.Cli.Withhold

  build-depends:
    , aeson                             >=2.1     && <2.3
    , aeson-pretty
    , async
    , base                              >=4.14    && <5
    , base16-bytestring
    , bytestring                        >=0.11    && <0.13
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-tx-tools:tx-build
    , case-insensitive
    , conformance
    , containers                        >=0.6     && <0.8
    , directory                         >=1.3     && <1.4
    , filepath                          >=1.4     && <1.6
    , http-types
    , microlens
    , mts:mpf-write
    , operational                       >=0.2.4.2 && <0.3
    , plutus-core
    , process                           >=1.6     && <1.7
    , singular-registry
    , singular-registry:koios-http
    , singular-registry:local-services
    , text                              >=2.0     && <2.2
    , time
    , unix
    , wai
    , warp

  ghc-options:    -threaded -with-rtsopts=-N

executable fold-budget-regression
  import:         warnings, live-runner
  hs-source-dirs: test/fold-budget
  main-is:        BudgetMain.hs

-- #287: the extent check CI runs over the receipts of every live run.
executable conformance-extent
  import:         warnings
  hs-source-dirs: test/extent
  main-is:        ExtentMain.hs
  build-depends:
    , aeson        >=2.1  && <2.3
    , base         >=4.14 && <5
    , conformance
    , containers
    , directory
    , filepath
    , text

test-suite conformance-tests
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test app app-default app-cli ../offchain/test-tags
  main-is:        Main.hs

  -- the history-withholding forwarder runs warp, whose timer manager needs
  -- the threaded runtime
  ghc-options:    -threaded
