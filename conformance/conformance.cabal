cabal-version:      3.4
name:               conformance
version:            0.1.0.0
synopsis:           Singular consumer comparison evidence reader
description:
  Published comparison requirements and a reader that derives their evidence
  state from validated run receipts. Missing comparisons remain uncovered.

license:            Apache-2.0
license-file:       LICENSE
author:             Paolo Veronelli
maintainer:         paolo.veronelli@gmail.com
category:           Cardano
build-type:         Simple
extra-source-files: model-revision
extra-doc-files:    README.md
data-files:
  rows.json
  test/fixtures/reader/*.json

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-language:   GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import: warnings
  hs-source-dirs: lib
  exposed-modules:
    Conformance.EvidencePage
    Conformance.Receipt
    Conformance.Replay
    Conformance.Rows
  build-depends:
    , aeson >=2.1 && <2.3
    , base >=4.14 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , crypton
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6
    , process >=1.6 && <1.7
    , text >=2.0 && <2.2

executable conformance
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: Paths_conformance
  build-depends:
    , base
    , conformance
    , text

test-suite conformance-tests
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test ../offchain/test-tags
  main-is: Main.hs
  other-modules:
    Conformance.Support.EvidencePage
    Conformance.Support.Receipt
    Conformance.Support.Replay
    Conformance.Support.Rows
    Paths_conformance
    Test.Tags
  build-depends:
    , aeson >=2.1 && <2.3
    , base >=4.14 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , filepath >=1.4 && <1.6
    , text >=2.0 && <2.2
    , conformance
    , hspec >=2.7 && <2.12
    , temporary >=1.3 && <1.4
