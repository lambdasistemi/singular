  hs-source-dirs: app ../offchain/private-facade
  other-modules:
    Conformance.BlueprintEncoding
    Conformance.FoldFixture
    Conformance.ForkKeys
    Conformance.Mirror
    Conformance.Run
    Conformance.Run.Actor
