cabal-version: 3.4
name:          conformance
version:       0.1.0.0
synopsis:      Singular consumer conformance rows on a real devnet
description:
  Row runner for epic 18 (issue #63): executes the generic registry
  operations the naming demonstration cannot reach against a real
  devnet, with attributable refusals, executing negative controls and
  measurements against the devnet protocol maxima.
license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple
extra-doc-files:
  README.md
data-files:
  rows.json
  test/fixtures/receipts/receipt-CG02.json
  test/fixtures/receipts/receipt-CG05.json
  test/fixtures/bad-accepted/receipt-CG02.json
  test/fixtures/bad-refused/receipt-CG05.json
  test/fixtures/bad-venue/receipt-CG05.json
  test/fixtures/bad-no-rejected/receipt-CG05.json
  test/fixtures/bad-accepted-rejected/receipt-CG02.json
  test/fixtures/duplicate/receipt-CG02-a.json
  test/fixtures/duplicate/receipt-CG02-b.json
  test/fixtures/malformed/receipt-CG02.json
  test/fixtures/good-blueprint-check/receipt-CS01.json
  test/fixtures/good-param-check/receipt-CS06.json
  test/fixtures/bad-blueprint-tx/receipt-CS01.json

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-language: GHC2021

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:           warnings
  hs-source-dirs:   lib
  exposed-modules:
    Conformance.Authenticate
    Conformance.Receipt
    Conformance.Refusal
    Conformance.Rows
  build-depends:
    , aeson >=2.1 && <2.3
    , base >=4.14 && <5
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6
    , process >=1.6 && <1.7
    , text >=2.0 && <2.2

executable conformance
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:
    Conformance.CS01
    Conformance.Mirror
    Conformance.Run
    Paths_conformance
  build-depends:
    , aeson >=2.1 && <2.3
    , async
    , base >=4.14 && <5
    , base16-bytestring
    , bytestring >=0.11 && <0.13
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-mpfs-cage
    , cardano-node-clients
    , cardano-node-clients:devnet
    , cardano-strict-containers
    , cardano-tx-tools:tx-build
    , conformance
    , containers >=0.6 && <0.8
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6
    , microlens
    , mts:mpf-write
    , ouroboros-network
    , plutus-core
    , plutus-tx
    , process >=1.6 && <1.7
    , text >=2.0 && <2.2
    , time
    , unix

  ghc-options:      -threaded -with-rtsopts=-N

test-suite conformance-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Conformance.AuthenticateSpec
    Conformance.ReceiptSpec
    Conformance.RefusalSpec
    Conformance.RowsSpec
    Paths_conformance
  build-depends:
    , aeson >=2.1 && <2.3
    , base >=4.14 && <5
    , bytestring >=0.11 && <0.13
    , conformance
    , containers >=0.6 && <0.8
    , hspec >=2.7 && <2.12
    , text >=2.0 && <2.2
