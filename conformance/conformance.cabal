cabal-version:      3.4
name:               conformance
version:            0.1.0.0
synopsis:           Singular consumer conformance rows on a real devnet
description:
  Row runner for epic 18 (issue #63): executes the generic registry
  operations the naming demonstration cannot reach against a real
  devnet, with attributable refusals, executing negative controls and
  measurements against the devnet protocol maxima.

license:            Apache-2.0
license-file:       LICENSE
author:             Paolo Veronelli
maintainer:         paolo.veronelli@gmail.com
category:           Cardano
build-type:         Simple
extra-source-files: model-revision
extra-doc-files:    README.md
data-files:
  rows.json
  test/fixtures/bad-accepted/receipt-CG02.json
  test/fixtures/bad-accepted-rejected/receipt-CG02.json
  test/fixtures/bad-blueprint-tx/receipt-CS01.json
  test/fixtures/bad-limit/receipt-CG05.json
  test/fixtures/bad-no-rejected/receipt-CG05.json
  test/fixtures/bad-phase/receipt-CG05.json
  test/fixtures/bad-refused/receipt-CG05.json
  test/fixtures/bad-venue/receipt-CG05.json
  test/fixtures/derivation-bareprefix/receipt-CA04.json
  test/fixtures/derivation-incomplete/receipt-CA04.json
  test/fixtures/derivation-legacyvenue/receipt-CA04.json
  test/fixtures/derivation-mislabelled/receipt-CA04.json
  test/fixtures/derivation-missingsource/receipt-CA04.json
  test/fixtures/derivation-valid/receipt-CA04.json
  test/fixtures/derivation-venue/receipt-CA04.json
  test/fixtures/duplicate/receipt-CG02-a.json
  test/fixtures/duplicate/receipt-CG02-b.json
  test/fixtures/good-blueprint-check/receipt-CS01.json
  test/fixtures/good-param-check/receipt-CS06.json
  test/fixtures/live-steps/overflowed-retirement.txt
  test/fixtures/malformed/receipt-CG02.json
  test/fixtures/node-refusals/*.txt
  test/fixtures/partial-empty/receipt-CS03.json
  test/fixtures/partial-incomplete/receipt-CS03.json
  test/fixtures/partial-legacy/receipt-CS03.json
  test/fixtures/partial-nodecl/receipt-CS03.json
  test/fixtures/partial-refused/receipt-CS03.json
  test/fixtures/partial-success/receipt-CS03.json
  test/fixtures/partial-valid/receipt-CS03.json
  test/fixtures/receipts/receipt-CG02.json
  test/fixtures/receipts/receipt-CG05.json

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-language:   GHC2021
  default-extensions:
    BlockArguments
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:          warnings
  hs-source-dirs:  lib
  exposed-modules:
    Conformance.Authenticate
    Conformance.Book
    Conformance.Cli.Controls
    Conformance.Compare.Perturbation
    Conformance.Compare.Registration
    Conformance.Edge.EarlyReject
    Conformance.Edge.Exit
    Conformance.Edge.Occupied
    Conformance.Edge.Permanent
    Conformance.Edge.Programs
    Conformance.Edge.Register
    Conformance.Edge.Retire
    Conformance.Edge.RetractionWindow
    Conformance.Edge.Sequence
    Conformance.EvidencePage
    Conformance.Extent
    Conformance.Fold.KeyedMint
    Conformance.Lean.Oracle
    Conformance.Lean.Registration
    Conformance.Lean.Retirement
    Conformance.NodeRejection
    Conformance.Observe.Payments
    Conformance.PurposeUnits
    Conformance.Receipt
    Conformance.Refusal
    Conformance.Replay
    Conformance.RowNames
    Conformance.Rows
    Conformance.Story.Binding
    Conformance.Story.Identity
    Conformance.Story.Live
    Conformance.Story.Specification

  other-modules:   Conformance.Evidence.Asset
  build-depends:
    , aeson             >=2.1     && <2.3
    , base              >=4.14    && <5
    , bytestring        >=0.11    && <0.13
    , containers        >=0.6     && <0.8
    , crypton
    , directory         >=1.3     && <1.4
    , filepath          >=1.4     && <1.6
    , operational       >=0.2.4.2 && <0.3
    , process           >=1.6     && <1.7
    , scientific        >=0.3     && <0.4
    , template-haskell  >=2.18    && <2.25
    , text              >=2.0     && <2.2
    , vector            >=0.13    && <0.14

