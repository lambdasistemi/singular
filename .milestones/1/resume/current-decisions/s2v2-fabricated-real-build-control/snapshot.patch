+        [] -> error "sweepTx: no UTxOs"
+        (u : _) -> pure u
+    let (stateIn, stateOut) = stateUtxo
+        evalTx tx = do
+            r <- Cage.evaluateTx prov tx
+            pure $ Map.map (\case Left e -> Left (show e); Right eu -> Right eu) r
+        prog = do
+            _ <- Tx.spendScript (fst garbageOut) (Sweep (txInToRef stateIn))
