+        Tx.build
+            (Tx.mkPParamsBound pp)
+            (Tx.InterpretIO (const (pure undefined)))
+            evalTx
+            [feeUtxo, stateUtxo]
+            []
+            feeAddr
+            (prog :: Tx.TxBuild NoCtx Void ())
+    case result of
+        Right tx -> pure tx
+        Left err -> error ("burningTx: build failed: " <> show err)
