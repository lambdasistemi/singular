+    after <- Cage.queryUTxOs prov reqAddr
+    case sortOn fst [(i, o) | (i, o) <- after, txInTxIdHex i == txIdHex tx] of
+        ((i, o) : _) -> pure (i, o)
+        [] -> failWith "parkGarbage: garbage output not found"
