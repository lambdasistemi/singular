 [{"class": "authorization",
   "claim": "only the controller's signature admits an update or a booking",
   "atom": "A1"},
  {"class": "evidence-binding",
   "claim":
   "the insertion approval's destination binds this contract and the envelope hash; the envelope and the application name the actual registry state asset",
   "atom": "A2"},
  {"class": "value",
   "claim":
   "the protected deposit equals the insertion request's deposit and is never below it at the contract",
   "atom": "A3"},
  {"class": "custody",
   "claim":
   "the token stays at the contract through updates, termination booking and rejects",
   "atom": "A4"},
  {"class": "refusal",
   "claim":
   "no spend other than update and fold is accepted, and no uncertified edge is booked",
   "atom": "A5"},
  {"class": "terminality",
   "claim":
   "a release happens only in the registry's accepted fold of the same key's updateTerminal, whose own mint burns exactly that key's active token",
   "atom": "A6"},
  {"class": "value",
   "claim":
   "each recipient receives the sum of every selected request's registry payment and every released deposit owed to it",
   "atom": "A7"},
  {"class": "composition",
   "claim":
   "duplicate insertion and resurrection are refused by the registry fold, not the application",
   "atom": "A8"},
  {"class": "composition",
   "claim": "payload updates leave the registry and the bookings unchanged",
   "atom": "A9"},
  {"class": "custody",
   "claim":
   "the inventory holds each output occurrence once: references are pairwise distinct and no key has two live outputs",
   "atom": "A10"}]}
