cabal-version: 3.4
name:          open-datum
version:       1.1.0.0
synopsis:      Open-datum application against the Singular registry library
description:
  The open-datum application: envelope, booking, release rules, script,
  application value, entry commands and verbs, built against the
  singular-registry library and registry-cli. Code moves; behaviour does
  not change.

license:       Apache-2.0
license-file:  LICENSE
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

library
  import:           warnings
  visibility:       public
  default-language: GHC2021
  hs-source-dirs:   src
  exposed-modules:
    Singular.Application.OpenDatum.Build
    Singular.Application.OpenDatum.Command
    Singular.Application.OpenDatum.Envelope
    Singular.Application.OpenDatum.Help
    Singular.Application.OpenDatum.Registration
    Singular.Application.OpenDatum.Reader
    Singular.Application.OpenDatum.Inspect
    Singular.Application.OpenDatum.Requests.Booking
    Singular.Application.OpenDatum.Requests.Configuration
    Singular.Application.OpenDatum.Requests.Fold
    Singular.Application.OpenDatum.Requests.Holding
    Singular.Application.OpenDatum.Requests.Pending
    Singular.Application.OpenDatum.Requests.Records
    Singular.Application.OpenDatum.Requests.Refusal
    Singular.Application.OpenDatum.Requests.Script
    Singular.Application.OpenDatum.Root
    Singular.Application.OpenDatum.Run

  autogen-modules: Paths_open_datum
  other-modules:
    Paths_open_datum
    Singular.Application.OpenDatum.Requests.Assemble

  build-depends:
    , aeson                              >=2.1  && <2.3
    , base                               >=4.14 && <5
    , base16-bytestring
    , bytestring                         >=0.11 && <0.13
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers                         >=0.6  && <0.8
    , contra-tracer
    , crypton
    , memory
    , microlens
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , serialise
    , singular-registry
    , singular-registry:local-services
    , singular-registry:registry-cli
    , text                               >=2.0  && <2.2
    , transformers

executable open-datum
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    , base                    >=4.14 && <5
    , open-datum
    , singular-registry:registry-cli
  ghc-options: -threaded -with-rtsopts=-N

-- #742: a test harness for the refusals journey, never evidence and never a
-- product command: it builds the fold of a pending registration with one fact
-- made wrong and submits it, so that the node judges what the packaged commands
-- decline before they send. It lives with the application whose request
-- validator it exercises.
executable no-pin-refusals
  import:           warnings
  default-language: GHC2021
  hs-source-dirs:   refusals
  main-is:          Main.hs
  other-modules:    CreationCarrying BatchMeasurement
  build-depends:
    , aeson                              >=2.1  && <2.3
    , base                               >=4.14 && <5
    , bytestring                         >=0.11 && <0.13
    , cardano-binary
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-binary
    , cardano-ledger-api
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-tx-tools:tx-build
    , containers                         >=0.6  && <0.8
    , contra-tracer
    , directory
    , filepath
    , microlens
    , open-datum
    , plutus-core
    , plutus-tx
    , serialise
    , singular-registry
    , singular-registry:koios-http
    , singular-registry:local-services
    , singular-registry:registry-cli
    , text                               >=2.0  && <2.2

  ghc-options:      -threaded -with-rtsopts=-N

test-suite open-datum-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs:   test test-tags
  main-is:          Main.hs
  autogen-modules:  Paths_open_datum
  other-modules:
    Paths_open_datum
    Singular.Application.OpenDatum.BuildersSpec
    Singular.Application.OpenDatum.Value
    Singular.Application.OpenDatum.BuildSpec
    Singular.Application.OpenDatum.CreationWorld
    Singular.Application.OpenDatum.RequestBookingSpec
    Singular.Application.OpenDatum.RequestCommandSpec
    Singular.Application.OpenDatum.RequestConfigurationSpec
    Singular.Application.OpenDatum.RequestCreationSpec
    Singular.Application.OpenDatum.RequestFoldSpec
    Singular.Application.OpenDatum.RequestHoldingSpec
    Singular.Application.OpenDatum.ReaderSpec
    Singular.Application.OpenDatum.RequestTerminationFoldSpec
    Singular.Application.OpenDatum.RequestPublicationSpec
    Singular.Application.OpenDatum.RequestPendingSpec
    Singular.Application.OpenDatum.RequestRecordsSpec
    Singular.Application.OpenDatum.RequestScriptSpec
    Singular.Application.OpenDatum.RequestWorld
    Singular.Application.OpenDatum.EnvelopeSpec
    Singular.Application.OpenDatum.FoldSpec
    Singular.Application.OpenDatum.CommandRunSpec
    Singular.Application.OpenDatum.FlagGroupExtentSpec
    Singular.Application.OpenDatum.HelpSnapshotSpec
    Singular.Application.OpenDatum.ManagedStateSpec
    Singular.Application.OpenDatum.RecoverySpec
    Singular.Application.OpenDatum.StateTokenSpec
    Singular.Application.OpenDatum.TraceSpec
    Singular.Application.OpenDatum.WriteSpec
    Singular.Application.OpenDatum.CLISpec
    Singular.Application.OpenDatum.LibraryStateSpec
    Singular.Application.OpenDatum.WalletAdmissionSpec
    Singular.Application.OpenDatum.PartitionLibrarySpec
    Singular.Application.OpenDatum.ActorDirectorySpec
    Singular.Application.OpenDatum.ParserCorpusSpec
    Singular.Application.OpenDatum.SourcesSpec
    Singular.Application.OpenDatum.ClosedModeSpec
    Singular.Application.OpenDatum.PinGateSpec
    Singular.Application.OpenDatum.ApplicationSpec
    Singular.Application.OpenDatum.NeutralValueSpec
    Singular.Application.OpenDatum.StateTokenFixture
    Singular.Application.OpenDatum.RegistryStateTokenSpec
    Singular.Application.OpenDatum.RegistryAddressSpec
    Singular.Registry.AddressOracle
    Singular.PhaseLogFixture
    Singular.Provider.Koios.FakeServer
    Singular.Provider.Koios.Scripted
    Singular.Registry.RawChainFixture
    Singular.Registry.StubSession
    Singular.Registry.SyntheticLedger
    Singular.Registry.SyntheticTime
    Singular.Registry.TxBuilder.BookingFixture
    Test.Tags

  build-depends:
    , aeson
    , async
    , base                              >=4.14 && <5
    , base16-bytestring
    , bech32
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-allegra
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , cardano-strict-containers
    , cardano-tx-tools:tx-build
    , case-insensitive
    , containers
    , contra-tracer
    , crypton
    , directory
    , filepath
    , hspec
    , http-types
    , memory
    , microlens
    , mtl
    , mts:mpf-write
    , open-datum
    , ouroboros-consensus
    , plutus-ledger-api
    , plutus-core
    , plutus-tx
    , QuickCheck
    , serialise
    , singular-registry
    , singular-registry:local-services
    , singular-registry:registry-cli
    , singular-registry:koios-http
    , temporary
    , wai
    , warp
    , text
    , time
    , unix

  ghc-options:      -threaded
