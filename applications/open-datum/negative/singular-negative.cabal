cabal-version: 3.4
name: singular-negative
version: 0.1.0.0
synopsis: Adversarial singular host that submits forbidden moves unevaluated
description:
  The singular-negative executable shares the ordinary command-line
  sources by directory and depends on the singular-registry library.
  It builds the forbidden holding-spend shapes, signs with any named
  key file, skips every local check and local script evaluation, and
  submits. No ordinary executable links a host module.

license: Apache-2.0
license-file: LICENSE
author: Paolo Veronelli
maintainer: paolo.veronelli@gmail.com
category: Cardano
build-type: Simple

common warnings
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing
    -Wdeferred-out-of-scope-variables -Wpartial-type-signatures
    -Wredundant-constraints

  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedStrings
    RecordWildCards
    StrictData

executable singular-negative
  import: warnings
  default-language: GHC2021
  hs-source-dirs: app src
  main-is: Main.hs
  other-modules:
    Negative.Craft
    Negative.Parse
    Negative.Read
    Negative.Run
    Negative.Submit
  build-depends:
    , aeson
    , base >=4.14 && <5
    , bytestring
    , cardano-ledger-api
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers
    , microlens
    , plutus-core
    , singular-registry
    , singular-registry:local-services
    , singular-registry:registry-cli
    , open-datum
    , text
  ghc-options: -threaded -with-rtsopts=-N
