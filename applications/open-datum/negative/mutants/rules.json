{
  "mutants": [
    {
      "name": "release-retired-accepted",
      "patch": "release-retired-accepted.patch",
      "rule": "release-retired",
      "anchor": "expect envelope: Envelope = raw",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "controller-withdraws-outside-a-fold", "command": "withdraw"}],
      "control": "stranger-updates-the-key"
    },
    {
      "name": "update-controller-signature",
      "patch": "update-controller-signature.patch",
      "rule": "update-controller-signature",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "stranger-updates-the-key", "command": "update"}],
      "control": "controller-withdraws-outside-a-fold"
    },
    {
      "name": "update-escape",
      "patch": "update-escape.patch",
      "rule": "update-escape",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "controller-tamper-address", "command": "update"}],
      "control": "controller-withdraws-outside-a-fold"
    },
    {
      "name": "update-control",
      "patch": "update-control.patch",
      "rule": "update-control",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "controller-tamper-controller", "command": "update"}, {"pair": "controller-tamper-datum", "command": "update"}, {"pair": "controller-tamper-deposit", "command": "update"}],
      "control": "controller-withdraws-outside-a-fold"
    },
    {
      "name": "token-continuation-leaves-the-holding",
      "patch": "token-continuation-leaves-the-holding.patch",
      "rules": ["update-escape", "update-control"],
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "controller-tamper-token", "command": "update"}],
      "side_flips": [{"pair": "controller-tamper-address", "command": "update"}, {"pair": "controller-tamper-controller", "command": "update"}, {"pair": "controller-tamper-datum", "command": "update"}, {"pair": "controller-tamper-deposit", "command": "update"}],
      "control": "controller-withdraws-outside-a-fold"
    },
    {
      "name": "termination-booking-controller-checks",
      "patch": "termination-booking-controller-checks.patch",
      "rules": ["app-controller-signature"],
      "anchor": "pub fn bookTerminationRefusal(",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "stranger-terminates-the-key", "command": "terminate"}],
      "control": "stranger-updates-the-key"
    },
    {
      "name": "fold-accepts-a-short-donation",
      "patch": "fold-accepts-a-short-donation.patch",
      "registry_source": true,
      "rule": "fold-donation-mismatch",
      "file": "onchain/lib/registry/modify.ak",
      "flip": [{"pair": "short-fold-of-a-booked-termination", "command": "fold"}],
      "control": "stranger-updates-the-key"
    },
    {
      "name": "registry-accepts-a-taken-key",
      "patch": "registry-accepts-a-taken-key.patch",
      "registry_source": true,
      "file": "onchain/lib/registry/fold.ak",
      "flip": [{"pair": "stranger-registers-a-taken-key", "command": "insert"}, {"pair": "owner-registers-a-taken-key-again", "command": "insert"}, {"pair": "owner-revives-a-terminated-key", "command": "insert"}, {"pair": "stranger-revives-a-terminated-key", "command": "insert"}],
      "control": "stranger-updates-the-key"
    },
    {
      "name": "closed-update-accepted",
      "patch": "closed-update-accepted.patch",
      "rule": "closed-datum-update",
      "file": "applications/open-datum/onchain/validators/open_datum.ak",
      "flip": [{"pair": "closed-update", "command": "update"}],
      "control": "stranger-updates-the-key"
    }
  ]
}
