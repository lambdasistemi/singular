# Build the plutus.json blueprint via Nix — print the store path and
# leave no `result` symlink (Singular's `/result*` ignore is
# root-anchored and does not cover onchain/result).
build:
    nix build --no-link --print-out-paths

# Enter Aiken dev shell
develop:
    nix develop

# Back-compat alias (was the only named shell pre-split)
develop-aiken:
    nix develop .#aiken

# Build the blueprint directly with aiken — pinned toolchain (D-006),
# never whatever aiken happens to be on the caller's PATH.
aiken-build:
    nix develop --command aiken build

# Run aiken tests — pinned toolchain (D-006)
test:
    nix develop --command aiken check
