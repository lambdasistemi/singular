# Build plutus.json blueprint via Nix
build:
    nix build

# Enter Aiken dev shell
develop:
    nix develop

# Back-compat alias (was the only named shell pre-split)
develop-aiken:
    nix develop .#aiken

# Build blueprint directly with aiken (requires aiken in PATH)
aiken-build:
    aiken build

# Run aiken tests
test:
    aiken check
